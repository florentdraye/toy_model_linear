universe = vanilla
executable = /bin/bash
arguments = run_emergence_locations.sh /fast/fdraye/toy_model_linear/emergence_small32_means_s$(seed) --out-dir /fast/fdraye/toy_model_linear/emergence_small32_locations_s$(seed)
