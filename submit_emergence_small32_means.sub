# Re-evaluate the existing width-128 models on the width-512 experiment's fixed 32-latent bank.
# Submit after emergence_large_means_s46/history.json exists.
# condor_submit_bid 2000 submit_emergence_small32_means.sub
universe = vanilla
executable = /bin/bash
arguments = run_emergence_means.sh /fast/fdraye/toy_model_linear/emergence_wide_s$(seed) --evaluation-run /fast/fdraye/toy_model_linear/emergence_large_means_s46 --out-dir /fast/fdraye/toy_model_linear/emergence_small32_means_s$(seed) --site suffix --contrast reference
initialdir = /lustre/home/fdraye/projects/toy_model_linear
request_gpus = 1
request_cpus = 4
request_memory = 24 GB
requirements = (CUDACapability == 9.0) && (Machine =!= "i101.internal.cluster.is.localnet") && (Machine =!= "g155.internal.cluster.is.localnet") && (Machine =!= "i205.internal.cluster.is.localnet") && (Machine =!= "i207.internal.cluster.is.localnet")
+IsDocker = False
stream_output = True
stream_error = True
output = /fast/fdraye/toy_model_linear/logs/emergence_small32_means_$(Cluster).$(Process).out
error = /fast/fdraye/toy_model_linear/logs/emergence_small32_means_$(Cluster).$(Process).err
log = /fast/fdraye/toy_model_linear/logs/emergence_small32_means_$(Cluster).$(Process).log
queue seed in 46,47,48
