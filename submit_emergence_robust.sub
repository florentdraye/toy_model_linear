# Wider fixed residual slice, milder frequency range, weaker weight decay.
# This condition is kept separate from the single-token 30x experiment.
universe = vanilla
executable = /bin/bash
arguments = run_emergence.sh --out-dir /fast/fdraye/toy_model_linear/emergence_wide_$(run_tag) --seed $(seed) --steps 10000 --site suffix --direction-method optimized --steer-depth 1 --frequency-ratio $(ratio) --weight-decay 0.1 --save-models
initialdir = /lustre/home/fdraye/projects/toy_model_linear
request_gpus = 1
request_cpus = 4
request_memory = 24 GB
requirements = (CUDACapability == 9.0) && (Machine =!= "i101.internal.cluster.is.localnet") && (Machine =!= "g155.internal.cluster.is.localnet") && (Machine =!= "i205.internal.cluster.is.localnet")
+IsDocker = False
stream_output = True
stream_error = True
output = /fast/fdraye/toy_model_linear/logs/emergence_$(Cluster).$(Process).out
error = /fast/fdraye/toy_model_linear/logs/emergence_$(Cluster).$(Process).err
log = /fast/fdraye/toy_model_linear/logs/emergence_$(Cluster).$(Process).log
queue seed,ratio,run_tag from (
46 10 s46
47 10 s47
48 10 s48
46 1 uniform
)
